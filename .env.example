# 应用
APP_NAME=车修宝
DEBUG=true
SECRET_KEY=change-me-in-production

# 数据库
# 生产为 MySQL；本地也可用 PostgreSQL
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/chexiu_bao?charset=utf8mb4
# DATABASE_URL=postgresql://localhost:5432/chexiu_bao

# Redis（可选，未配置时使用内存缓存）
REDIS_URL=redis://localhost:6379/0

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 文件存储
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# CORS（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 百度 OCR（可选，未配置时使用本地 hyperlpr3）
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=

# 平台管理员密钥（用于手动激活订阅订单）
# ADMIN_API_KEY=

# 微信小程序（未配置 SECRET 时 /mp/auth 使用 mock openid，仅本地联调）
WECHAT_MP_APP_ID=wxeeac56d862611875
# WECHAT_MP_APP_SECRET=

# 抖音小程序（platform=douyin；须与 project.tt.json 的 appid 一致）
DOUYIN_MP_APP_ID=tt311e47a3af6706e301
# DOUYIN_MP_APP_SECRET=在抖音开放平台「开发配置」生成，仅填服务器 .env，勿提交 Git
# DOUYIN_MP_SANDBOX=false

